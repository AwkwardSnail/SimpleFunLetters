<Application x:Class="SimpleFunLetters.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Awkward Snail colours: dark desk, green phosphor text, white paper. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0D0F0C"/>
    <SolidColorBrush x:Key="BarBrush" Color="#121510"/>
    <SolidColorBrush x:Key="LineBrush" Color="#24301F"/>
    <SolidColorBrush x:Key="LineHoverBrush" Color="#3A4D32"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#7FDC8A"/>
    <SolidColorBrush x:Key="GreenDimBrush" Color="#4F8A56"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#FDFDFB"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>

    <FontFamily x:Key="PageFont">pack://application:,,,/Fonts/#Atkinson Hyperlegible Next</FontFamily>

    <!-- Toolbar buttons. Not focusable, so typing focus stays on the page. -->
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDimBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GreenDimBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- One letter in the grid on the left. -->
    <Style x:Key="LetterTile" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="57"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="Foreground" Value="{StaticResource GreenDimBrush}"/>
    </Style>

    <!-- Pen / Eraser: a pair where one is always chosen. -->
    <Style x:Key="ToolRadio" TargetType="RadioButton">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDimBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DoneButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="28,0"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="Separator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Margin" Value="10,4,16,4"/>
      <Setter Property="Background" Value="{StaticResource LineBrush}"/>
    </Style>
  </Application.Resources>
</Application>
