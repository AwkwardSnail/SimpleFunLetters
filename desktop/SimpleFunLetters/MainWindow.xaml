<Window x:Class="SimpleFunLetters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleFunLetters"
        Title="SimpleLetters Fun" Width="1360" Height="940" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource GreenBrush}"
        FontFamily="{StaticResource PageFont}" FontSize="15"
        UseLayoutRounding="True">

  <Window.CommandBindings>
    <CommandBinding Command="Open" Executed="Open_Executed"/>
    <CommandBinding Command="Save" Executed="Save_Executed"/>
    <CommandBinding Command="Print" Executed="Print_Executed"/>
  </Window.CommandBindings>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BarBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
      <!-- Each group of controls wraps to the next line as a whole when the window is narrow. -->
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <Button Style="{StaticResource ToolButton}" Command="Open" Content="Open" ToolTip="Open a letter (Ctrl+O)"/>
          <Button Style="{StaticResource ToolButton}" Command="Save" Content="Save" ToolTip="Save (Ctrl+S)"/>
          <Button Style="{StaticResource ToolButton}" Command="Print" Content="Print" ToolTip="Print on A4 (Ctrl+P)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <Border Style="{StaticResource Separator}"/>

          <Button Style="{StaticResource ToolButton}" Command="Undo" CommandTarget="{Binding ElementName=Editor}"
                  Content="Undo" ToolTip="Undo (Ctrl+Z)"/>
          <Button Style="{StaticResource ToolButton}" Command="Redo" CommandTarget="{Binding ElementName=Editor}"
                  Content="Redo" ToolTip="Redo (Ctrl+Y)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <Border Style="{StaticResource Separator}"/>

          <!-- Font and style: with text selected they change the selection;
               otherwise they apply to what you type next. -->
          <!-- One button: shows the font in use (in that font); press it to switch. -->
          <Button x:Name="FontButton" Style="{StaticResource ToolButton}" MinWidth="110" Content="Font: Sans"
                  FontFamily="{StaticResource PageFont}" Click="Font_Click"/>
          <ToggleButton x:Name="BoldButton" Style="{StaticResource ToggleTool}" Margin="10,0,6,0" Click="Bold_Click"
                        ToolTip="Bold (Ctrl+B)">
            <TextBlock Text="B" FontWeight="Bold"/>
          </ToggleButton>
          <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToggleTool}" Click="Italic_Click"
                        ToolTip="Italic (Ctrl+I)">
            <TextBlock Text="I" FontStyle="Italic"/>
          </ToggleButton>
          <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToggleTool}" Click="Underline_Click"
                        ToolTip="Underline (Ctrl+U)">
            <TextBlock Text="U" TextDecorations="Underline"/>
          </ToggleButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <Border Style="{StaticResource Separator}"/>

          <TextBlock Text="Text size" Foreground="{StaticResource GreenDimBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="SmallerButton" Style="{StaticResource StepperButton}" Content="−"
                  Click="Smaller_Click" ToolTip="Smaller text from here on"/>
          <TextBlock x:Name="SizeLabel" Text="12 pt" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center"/>
          <Button x:Name="LargerButton" Style="{StaticResource StepperButton}" Content="+"
                  Click="Larger_Click" ToolTip="Larger text from here on"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <Border Style="{StaticResource Separator}"/>

          <TextBlock Text="Zoom" Foreground="{StaticResource GreenDimBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="ZoomOutButton" Style="{StaticResource StepperButton}" Content="−"
                  Click="ZoomOut_Click" ToolTip="Make the page smaller on screen (Ctrl + mouse wheel)"/>
          <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center"/>
          <Button x:Name="ZoomInButton" Style="{StaticResource StepperButton}" Content="+"
                  Click="ZoomIn_Click" ToolTip="Make the page bigger on screen (Ctrl + mouse wheel)"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: the letters, or the drawing pane for one letter -->
      <Border Grid.Column="0" Background="{StaticResource BarBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <ScrollViewer x:Name="LettersView" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="18,16,18,24">
              <TextBlock Text="Your letters" FontSize="20" Margin="0,0,0,4"/>
              <TextBlock Text="Click a letter to draw your own. Anything you type after that uses your drawing."
                         Foreground="{StaticResource GreenDimBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

              <TextBlock Text="Capital letters" Style="{StaticResource SectionLabel}"/>
              <WrapPanel x:Name="CapitalsPanel" Margin="0,0,0,14"/>
              <TextBlock Text="Small letters" Style="{StaticResource SectionLabel}"/>
              <WrapPanel x:Name="SmallsPanel" Margin="0,0,0,14"/>
              <TextBlock Text="Punctuation" Style="{StaticResource SectionLabel}"/>
              <WrapPanel x:Name="PunctuationPanel" Margin="0,0,0,14"/>
              <TextBlock Text="Numbers" Style="{StaticResource SectionLabel}"/>
              <WrapPanel x:Name="NumbersPanel"/>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="DrawView" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
            <StackPanel Margin="18,16,18,24" HorizontalAlignment="Center">
              <TextBlock x:Name="DrawTitle" Text="Draw your A" FontSize="20" Margin="0,0,0,4"/>
              <!-- What to do next: changes with the tool (and each step of an arc). -->
              <TextBlock x:Name="DrawHint" Text="Click and drag to draw. The right button rubs out. Letters sit on the green line."
                         Foreground="{StaticResource GreenDimBrush}" TextWrapping="Wrap" Width="360" MinHeight="40"
                         HorizontalAlignment="Left" Margin="0,0,0,10"/>

              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                <local:DrawingGrid x:Name="Drawing"/>
              </Border>

              <!-- The drawing tools, Undo and Clear: two rows of three, each with its icon. -->
              <UniformGrid Columns="3" Width="366" Margin="-3,8,0,0" HorizontalAlignment="Left">
                <RadioButton x:Name="PenTool" Style="{StaticResource BigToolRadio}" IsChecked="True"
                             GroupName="Tool" Checked="Tool_Checked" ToolTip="Draw by clicking and dragging">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,17 L4,13 L13,4 L16,7 L7,16 Z M11,6 L14,9"/>
                    <TextBlock Text="Pen" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="EraserTool" Style="{StaticResource BigToolRadio}"
                             GroupName="Tool" Checked="Tool_Checked" ToolTip="Rub out by clicking and dragging">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M2,12 L9,5 L16,12 L10,18 L8,18 Z M5.5,8.5 L12.5,15.5 M10,18 L18,18"/>
                    <TextBlock Text="Eraser" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LineTool" Style="{StaticResource BigToolRadio}"
                             GroupName="Tool" Checked="Tool_Checked" ToolTip="Draw a straight line">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M4,16 L16,4 M2.5,14.5 H5.5 V17.5 H2.5 Z M14.5,2.5 H17.5 V5.5 H14.5 Z"/>
                    <TextBlock Text="Line" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ArcTool" Style="{StaticResource BigToolRadio}"
                             GroupName="Tool" Checked="Tool_Checked" ToolTip="Draw part of a circle, or all of it">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,15 A12,12 0 0 1 15,3 M1.5,15 H4.5 M3,13.5 V16.5 M13.5,3 H16.5 M15,1.5 V4.5 M14,14 L15,15 M15,14 L14,15"/>
                    <TextBlock Text="Arc" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <Button x:Name="UndoDrawingButton" Style="{StaticResource BigToolButton}" IsEnabled="False"
                        Click="UndoDrawing_Click" ToolTip="Take back the last stroke, line, arc, Clear or change of squares (Ctrl+Z)">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M7,4 L3,8 L7,12 M3,8 H12 A4.5,4.5 0 0 1 12,17 H7"/>
                    <TextBlock Text="Undo" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource BigToolButton}" Click="ClearDrawing_Click"
                        ToolTip="Rub out the whole drawing. Done with nothing drawn goes back to the normal letter.">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,3 H17 V17 H3 Z M7,7 L13,13 M13,7 L7,13"/>
                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </UniformGrid>

              <!-- The size of the squares. Changing it fits the drawing onto the new squares. -->
              <DockPanel Width="363" Margin="0,5,0,0" HorizontalAlignment="Left">
                <TextBlock Text="Squares" Foreground="{StaticResource GreenDimBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <UniformGrid Columns="3">
                <RadioButton x:Name="LargeSquares" Style="{StaticResource BigToolRadio}" Padding="2,0" Tag="24"
                             GroupName="Squares" Checked="Squares_Checked" ToolTip="Big squares: quick, blocky letters (18 × 24)">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,3 H17 V17 H3 Z M10,3 V17 M3,10 H17"/>
                    <TextBlock Text="Large" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MediumSquares" Style="{StaticResource BigToolRadio}" Padding="2,0" Tag="40"
                             GroupName="Squares" Checked="Squares_Checked" ToolTip="Medium squares for more detail (30 × 40)">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,3 H17 V17 H3 Z M7.67,3 V17 M12.33,3 V17 M3,7.67 H17 M3,12.33 H17"/>
                    <TextBlock Text="Medium" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SmallSquares" Style="{StaticResource BigToolRadio}" Padding="2,0" Tag="60"
                             GroupName="Squares" Checked="Squares_Checked" ToolTip="Small squares for the finest detail (45 × 60)">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource ToolIcon}" Data="M3,3 H17 V17 H3 Z M6.5,3 V17 M10,3 V17 M13.5,3 V17 M3,6.5 H17 M3,10 H17 M3,13.5 H17"/>
                    <TextBlock Text="Small" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                </UniformGrid>
              </DockPanel>

              <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                <Button Style="{StaticResource DoneButton}" Content="Done" Click="DoneDrawing_Click"
                        ToolTip="Use this drawing for everything you type from now on"/>
                <Button Style="{StaticResource ToolButton}" Content="Cancel" Click="CancelDrawing_Click" Height="40"
                        ToolTip="Go back without changing this letter"/>
              </StackPanel>
              <Button x:Name="ApplyToExistingButton" Style="{StaticResource ToolButton}" Height="40" Margin="0,10,0,0"
                      HorizontalAlignment="Left" Click="ApplyToExisting_Click" Content="Apply to existing text"
                      ToolTip="Use this drawing, and change this letter everywhere you've already written it. The drawing stays open."/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Right: the desk with the A4 page. The arrows above and to the left of
           the page mark the margins: click one to show its line, drag it to move it. -->
      <ScrollViewer x:Name="Desk" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    Focusable="False" SizeChanged="Desk_SizeChanged" PreviewMouseWheel="Desk_PreviewMouseWheel">
        <Grid x:Name="DeskContent" HorizontalAlignment="Center" Margin="12,20,40,48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Canvas x:Name="TopRuler" Grid.Row="0" Grid.Column="1"/>
          <Canvas x:Name="SideRuler" Grid.Row="1" Grid.Column="0"/>

          <!-- The paper: one white A4 sheet per page, made in MainWindow.Pages.cs.
               The shadows sit behind the text so the effect doesn't soften it. -->
          <Canvas x:Name="Sheets" Grid.Row="1" Grid.Column="1"/>

          <!-- Everything drawn on the sheets. Transparent, so the desk shows between pages. -->
          <Grid x:Name="Page" Grid.Row="1" Grid.Column="1" Background="Transparent" ClipToBounds="True">
            <!-- What you see: one picture of the editor's text per page (MainWindow.Pages.cs). -->
            <Canvas x:Name="Slices" IsHitTestVisible="False" UseLayoutRounding="False"/>
            <!-- The editor itself is one long column of text. It is kept invisible and
                 moved under the mouse, page by page, so clicks land on the right line. -->
            <Canvas x:Name="EditorHost" Opacity="0" UseLayoutRounding="False">
            <!-- Rich text so each piece of text keeps its own size, style and
                 letter drawings. Alignment, lists and the like are switched off in code. -->
            <RichTextBox x:Name="Editor"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Padding="0" Background="Transparent"
                         Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource InkBrush}"
                         FontFamily="{StaticResource PageFont}"
                         FocusVisualStyle="{x:Null}" SpellCheck.IsEnabled="True"
                         TextChanged="Editor_TextChanged"
                         SelectionChanged="Editor_SelectionChanged"
                         PreviewTextInput="Editor_PreviewTextInput"
                         PreviewKeyDown="Editor_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                         DataObject.Pasting="Editor_Pasting"
                         PreviewMouseWheel="Editor_PreviewMouseWheel">
              <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                  <Setter Property="Margin" Value="0"/>
                </Style>
              </RichTextBox.Resources>
            </RichTextBox>
            </Canvas>
            <Canvas x:Name="Guides" IsHitTestVisible="False"/>
          </Grid>

        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
